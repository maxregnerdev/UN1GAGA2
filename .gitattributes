# Set the default behavior, in case people don't have core.autocrlf set.
* text eol=lf

# Denote all files that are truly binary and should not be modified.

# Common file extensions
*.apk binary
*.apex binary
*.bin binary
*.so binary
*.jar binary
*.pk8 binary
*.ogg binary
*.ico binary
*.jpg binary
*.png binary
*.qmg binary
*.webp binary

# ROM-specific prebuilt blobs
prebuilts/bootable/deprecated-ota/updater binary
prebuilts/*/*/*/** binary
prebuilts/*/*/*/** binary
unica/mods/paradigm/system/** binary
unica/mods/prophide/system/bin/rezetprop binary

# Device-specific prebuilt blobs
platform/exynos8895/patches/abvendor/vendor/** binary
platform/exynos8895/patches/blobs/system/** binary
target/a52sxq/patches/wpss/vendor/firmware/** binary
target/a53x/patches/*/vendor/** binary
target/a73xq/patches/wpss/vendor/firmware/** binary
target/dream2lte/patches/kernel/** binary
target/dream2lte/patches/vendor/vendor/** binary
target/dreamlte/patches/kernel/** binary
target/dreamlte/patches/vendor/vendor/** binary
target/greatlte/patches/kernel/** binary
target/greatlte/patches/vendor/vendor/** binary
target/m52xq/patches/wpss/vendor/firmware/** binary
target/o1s/patches/variants/vendor/** binary
target/p3s/patches/variants/vendor/** binary
target/r9s/patches/vendor/vendor/** binary
target/t2s/patches/variants/vendor/** binary

# Maxregner flashable zip is text (shell scripts/props/map), not a binary
# blob. Placed after the prebuilts binary rule and uses -binary so the diff is
# shown as text. Also covers the RRO overlay source trees (XML/manifest) and
# the Magisk module scaffolding (sh/props/xml/json) so diffs are readable.
prebuilts/maxregner/rro/** -binary text eol=lf
prebuilts/maxregner/module/**/*.sh -binary text eol=lf
prebuilts/maxregner/module/**/*.prop -binary text eol=lf
prebuilts/maxregner/module/**/*.xml -binary text eol=lf
prebuilts/maxregner/module/**/*.json -binary text eol=lf
prebuilts/maxregner/zip/** -binary text eol=lf
