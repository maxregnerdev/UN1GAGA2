# === Maxregner Performance (maxregner_perf) ===
ro.maxregner.perf.enabled=true
ro.maxregner.perf.governor=schedutil
persist.sys.maxregner.perf.high_fps=true
persist.sys.maxregner.perf.target_fps=60
persist.sys.maxregner.perf.zram_size=2147483648
persist.sys.maxregner.perf.ksm=true
persist.sys.maxregner.perf.dash_charging=true
ro.maxregner.perf.thermal_profile=balanced
persist.sys.maxregner.perf.background_limit=32
persist.sys.maxregner.perf.cache_reclaim=aggressive
persist.sys.maxregner.perf.cpu_boost=true
persist.sys.maxregner.perf.gpu_boost=true
persist.sys.maxregner.perf.io_scheduler=kyber
persist.sys.maxregner.perf.swappiness=120
persist.sys.maxregner.perf.read_ahead=2048
persist.sys.maxregner.perf.dirty_ratio=20
persist.sys.maxregner.perf.dirty_background_ratio=5
persist.sys.maxregner.perf.oom_adj=true
persist.sys.maxregner.perf.low_memory_killer=false
persist.sys.maxregner.perf.free_memory_target=100

# === Maxregner Security (maxregner_security) ===
ro.maxregner.sec.enabled=true
persist.sys.maxregner.sec.hardened_init=true
persist.sys.maxregner.sec.verity_logging=true
persist.sys.maxregner.sec.lockdown=true
ro.maxregner.sec.sandbox=strict
persist.sys.maxregner.sec.auto_lock=30
persist.sys.maxregner.sec.lock_on_boot=true
persist.sys.maxregner.sec.encrypt_data=true
persist.sys.maxregner.sec.usb_debug_timeout=0
persist.sys.maxregner.sec.oem_unlock=false
persist.sys.maxregner.sec.allow_unknown_sources=false
persist.sys.maxregner.sec.screen_pinning=true
persist.sys.maxregner.sec.hide_sensitive_notifications=true
persist.sys.maxregner.sec.screenshot_secure=false
persist.sys.maxregner.sec.camera_secure=true
persist.sys.maxregner.sec.secure_folder=true
persist.sys.maxregner.sec.knox=false
