# Maxregner props (applied at boot via resetprop)
# Copyright (c) 2026 maxregner
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Runtime setprop overrides the read-only build.prop values for the whole boot
# session without writing the erofs partition. persist.* props persist across
# reboots through /data. Generated/verified by scripts/build_maxregner_zip.sh.

# === Maxregner Navigation (maxregner_nav) ===
ro.maxregner.nav.enabled=true
ro.maxregner.nav.mode=orb
ro.maxregner.nav.orb_scale=1.0
ro.maxregner.nav.orb_adaptive=true
ro.maxregner.nav.orb_auto_hide=false
ro.maxregner.nav.orb_snap=true
ro.maxregner.nav.orb_morph=true
ro.maxregner.nav.orb_glow=true
ro.maxregner.nav.orb_haptic=true
ro.maxregner.nav.orb_sound=true
persist.sys.maxregner.nav.gesture_sensitivity=0.8
persist.sys.maxregner.nav.haptic_feedback=true
persist.sys.maxregner.nav.dwell_threshold_ms=180
persist.sys.maxregner.nav.hide_legacy_bar=true
ro.maxregner.nav.fallback_gestures=true
ro.maxregner.nav.gesture_back=true
ro.maxregner.nav.gesture_recents=true
ro.maxregner.nav.gesture_one_handed=true
persist.sys.maxregner.nav.deadzone_dp=12
persist.sys.maxregner.nav.flick_threshold_dp=48
persist.sys.maxregner.nav.flick_velocity=4.0
persist.sys.maxregner.nav.swipe_up_threshold_dp=64
persist.sys.maxregner.nav.edge_swipe_width_dp=24
persist.sys.maxregner.nav.orb_idle_opacity=0.6
persist.sys.maxregner.nav.orb_active_opacity=1.0
persist.sys.maxregner.nav.orb_drag_friction=0.85
persist.sys.maxregner.nav.orb_spring_stiffness=0.9
persist.sys.maxregner.nav.orb_pulse_interval_ms=1200

# === Maxregner Sound Scheme (maxregner_sound) ===
ro.config.ringtone=Maxregner_Resonance.ogg
ro.config.notification_sound=Maxregner_Notice.ogg
ro.config.alarm_alert=Maxregner_Alarm.ogg
ro.config.media_sound=Maxregner_Resonance.ogg
ro.config.ringtone_2=Maxregner_Resonance.ogg
ro.config.notification_sound_2=Maxregner_Notice.ogg
ro.config.power_on=Maxregner_PowerOn.ogg
ro.config.power_off=Maxregner_PowerOff.ogg
ro.maxregner.sound.scheme=maxregner
ro.maxregner.sound.enabled=true
persist.sys.maxregner.sound.ui_effects=true
persist.sys.maxregner.sound.orb_morph=true
persist.sys.maxregner.sound.tick=Maxregner_Tick.ogg
persist.sys.maxregner.sound.swoosh=Maxregner_Swoosh.ogg
persist.sys.maxregner.sound.orb_morph=Maxregner_OrbMorph.ogg
persist.sys.maxregner.sound.volume_boost=0
persist.sys.maxregner.sound.bass_boost=2
persist.sys.maxregner.sound.treble_boost=1
persist.sys.maxregner.sound.spatial_audio=true
persist.sys.maxregner.sound.dolby_atmos=true
persist.sys.maxregner.sound.haptic_sync=true
persist.sys.maxregner.sound.charge_chime=Maxregner_PowerOn.ogg
persist.sys.maxregner.sound.unlock_chime=Maxregner_Swoosh.ogg
persist.sys.maxregner.sound.lock_chime=Maxregner_Tick.ogg
persist.sys.maxregner.sound.notif_pitch=0

