# === Maxregner Bootanimation (maxregner_bootanim) ===
ro.maxregner.bootanim.enabled=true
persist.sys.maxregner.bootanim.style=orb
persist.sys.maxregner.bootanim.sound=true
persist.sys.maxregner.bootanim.sound_file=Maxregner_PowerOn.ogg
persist.sys.maxregner.bootanim.loop_count=1
persist.sys.maxregner.bootanim.background=#0B1220
persist.sys.maxregner.bootanim.orb_color=#3B82F6

# === Maxregner Theme Profiles (maxregner_themes) ===
ro.maxregner.themes.enabled=true
persist.sys.maxregner.themes.profile=default
persist.sys.maxregner.themes.auto_switch=false
persist.sys.maxregner.themes.schedule_start=20
persist.sys.maxregner.themes.schedule_end=6
persist.sys.maxregner.themes.accent_default=#3B82F6
