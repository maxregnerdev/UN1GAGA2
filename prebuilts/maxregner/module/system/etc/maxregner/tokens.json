{
    "id": "maxregner_ui",
    "version": 2,
    "name": "Maxregner UI",
    "color": {
        "brand":        "#3B82F6",
        "brand_dark":   "#2563EB",
        "accent":       "#8B5CF6",
        "accent_tertiary": "#EC4899",
        "surface":      "#FFFFFF",
        "surface_dark": "#0F172A",
        "surface_elevated": "#F8FAFC",
        "surface_elevated_dark": "#1E293B",
        "on_surface":   "#0B1220",
        "on_surface_dark": "#E2E8F0",
        "on_surface_variant": "#475569",
        "on_surface_variant_dark": "#94A3B8",
        "outline":      "#475569",
        "outline_dark": "#64748B",
        "container":    "#1E293B",
        "container_high": "#334155",
        "inverse_surface": "#E2E8F0",
        "inverse_on_surface": "#0B1220",
        "orb":          "#6366F1",
        "orb_start":    "#3B82F6",
        "orb_end":      "#8B5CF6",
        "orb_glow":     "#A5B4FC",
        "orb_ring":     "#A5B4FC",
        "success":      "#10B981",
        "warning":      "#F59E0B",
        "danger":       "#EF4444",
        "info":         "#06B6D4",
        "ripple_light": "#1F3B82F6",
        "ripple_dark":  "#333B82F6"
    },
    "gradient": {
        "primary":   ["#3B82F6", "#8B5CF6"],
        "secondary": ["#8B5CF6", "#EC4899"],
        "tertiary":   ["#06B6D4", "#3B82F6"],
        "warm":      ["#F59E0B", "#EF4444"],
        "cool":      ["#06B6D4", "#8B5CF6"]
    },
    "shape": {
        "corner_xs": 8,
        "corner_s":  12,
        "corner_m":  16,
        "corner_l":  20,
        "corner_xl": 28,
        "corner_xxl": 48,
        "corner_orb": 9999,
        "corner_sheet": 24
    },
    "elevation": {
        "level0": 0,
        "level1": 1,
        "level2": 3,
        "level3": 6,
        "level4": 8,
        "level5": 12
    },
    "motion": {
        "duration_short":  150,
        "duration_medium": 280,
        "duration_long":   450,
        "duration_orb":     300,
        "duration_ripple": 250,
        "easing_standard":  [0.2, 0.0, 0.0, 1.0],
        "easing_emphasized": [0.2, 0.0, 0.0, 1.0],
        "easing_decelerate": [0.0, 0.0, 0.0, 1.0],
        "easing_accelerate": [0.4, 0.0, 1.0, 1.0],
        "stagger_ms": 40
    },
    "type": {
        "ramp": ["display", "headline", "title", "body", "label", "caption"],
        "sizes": {
            "display": 40,
            "headline": 28,
            "title": 20,
            "body": 16,
            "label": 14,
            "caption": 12
        },
        "font_family": "maxregner_sans",
        "font_weight_default": 400
    },
    "effects": {
        "blur_strength": 0.9,
        "blur_steps": 8,
        "glassmorphism": true,
        "neumorphism": false,
        "edge_lighting": true,
        "overscroll_glow": true,
        "smooth_scroll": true,
        "ripple_effect": true,
        "gradient_headers": true,
        "dynamic_color": true
    }
}
