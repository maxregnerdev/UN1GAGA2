<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/maxregner_progress_bg" />
            <corners android:radius="@dimen/maxregner_progress_radius" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/maxregner_progress_secondary" />
                <corners android:radius="@dimen/maxregner_progress_radius" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:startColor="@color/maxregner_accent" android:endColor="@color/maxregner_accent_secondary" android:angle="0" />
                <corners android:radius="@dimen/maxregner_progress_radius" />
            </shape>
        </clip>
    </item>
</layer-list>
