        <item name="android:dialogTheme">@style/Theme.DeviceDefault.Light.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.DeviceDefault.Light.Dialog.Alert</item>
        <item name="android:panelBackground">@color/colorSurface_device_default_light</item>
        <item name="android:listDivider">@drawable/maxregner_divider</item>
        <item name="android:divider">@color/divider_device_default_light</item>
        <item name="android:dividerVertical">@color/divider_device_default_light</item>
