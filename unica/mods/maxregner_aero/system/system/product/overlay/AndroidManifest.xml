<?xml version="1.0" encoding="utf-8"?>
<!-- Maxregner Aero runtime overlay. Targets android (framework-res) at high
     priority to override the motion/animation duration defaults the window
     and transition animators read when the Aero engine is active. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.maxregner.aero.overlay"
    android:versionCode="39"
    android:versionName="39.0">
    <overlay android:targetPackage="android" android:priority="9999" android:category="theme" />
    <application android:label="Maxregner Aero" android:hasCode="false" android:allowBackup="false" />
</manifest>
