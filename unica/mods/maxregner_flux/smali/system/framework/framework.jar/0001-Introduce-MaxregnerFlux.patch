From fae1026661d77cf0c22ee3fe64ed17327185f21b Mon Sep 17 00:00:00 2001
From: maxregner <maxregner@mesalabs.io>
Date: Wed, 16 Sep 2026 19:40:16 +0000
Subject: [PATCH] Introduce MaxregnerFlux

---
 .../io/mesalabs/unica/MaxregnerFlux.smali     | 264 ++++++++++++++++++
 1 file changed, 264 insertions(+)
 create mode 100644 smali_classes6/io/mesalabs/unica/MaxregnerFlux.smali

diff --git a/smali_classes6/io/mesalabs/unica/MaxregnerFlux.smali b/smali_classes6/io/mesalabs/unica/MaxregnerFlux.smali
new file mode 100644
index 0000000..7166144
--- /dev/null
+++ b/smali_classes6/io/mesalabs/unica/MaxregnerFlux.smali
@@ -0,0 +1,264 @@
+.class public final Lio/mesalabs/unica/MaxregnerFlux;
+.super Ljava/lang/Object;
+.source "MaxregnerFlux.java"
+
+
+# static fields
+.field private static final blacklist TAG:Ljava/lang/String; = "MaxregnerFlux"
+
+.field private static final blacklist MODE_OFF:I = 0x0
+
+.field private static final blacklist MODE_FIXED:I = 0x1
+
+.field private static final blacklist MODE_ADAPTIVE:I = 0x2
+
+.field private static final blacklist MODE_CONTENT:I = 0x3
+
+.field private static volatile blacklist sEnabled:Z
+
+.field private static volatile blacklist sMode:I
+
+.field private static volatile blacklist sMinHz:I
+
+.field private static volatile blacklist sMaxHz:I
+
+.field private static volatile blacklist sIdleHz:I
+
+.field private static volatile blacklist sLastFrameMs:J
+
+.field private static volatile blacklist sCurrentHz:I
+
+
+# direct methods
+.method static constructor blacklist <clinit>()V
+    .locals 1
+
+    invoke-static {}, Lio/mesalabs/unica/MaxregnerFlux;->readEnabled()Z
+
+    move-result v0
+
+    sput-boolean v0, Lio/mesalabs/unica/MaxregnerFlux;->sEnabled:Z
+
+    invoke-static {}, Lio/mesalabs/unica/MaxregnerFlux;->readMode()I
+
+    move-result v0
+
+    sput v0, Lio/mesalabs/unica/MaxregnerFlux;->sMode:I
+
+    invoke-static {}, Lio/mesalabs/unica/MaxregnerFlux;->readMinHz()I
+
+    move-result v0
+
+    sput v0, Lio/mesalabs/unica/MaxregnerFlux;->sMinHz:I
+
+    invoke-static {}, Lio/mesalabs/unica/MaxregnerFlux;->readMaxHz()I
+
+    move-result v0
+
+    sput v0, Lio/mesalabs/unica/MaxregnerFlux;->sMaxHz:I
+
+    invoke-static {}, Lio/mesalabs/unica/MaxregnerFlux;->readIdleHz()I
+
+    move-result v0
+
+    sput v0, Lio/mesalabs/unica/MaxregnerFlux;->sIdleHz:I
+
+    sget v0, Lio/mesalabs/unica/MaxregnerFlux;->sMaxHz:I
+
+    sput v0, Lio/mesalabs/unica/MaxregnerFlux;->sCurrentHz:I
+
+    const-wide/16 v0, 0x0
+
+    sput-wide v0, Lio/mesalabs/unica/MaxregnerFlux;->sLastFrameMs:J
+
+    return-void
+.end method
+
+.method private constructor blacklist <init>()V
+    .locals 0
+
+    invoke-direct {p0}, Ljava/lang/Object;-><init>()V
+
+    return-void
+.end method
+
+.method private static blacklist readEnabled()Z
+    .locals 2
+
+    const-string v0, "ro.maxregner.flux.enabled"
+
+    const/4 v1, 0x0
+
+    invoke-static {v0, v1}, Landroid/os/SystemProperties;->getBoolean(Ljava/lang/String;Z)Z
+
+    move-result v0
+
+    return v0
+.end method
+
+.method private static blacklist readMode()I
+    .locals 2
+
+    const-string v0, "ro.maxregner.flux.mode"
+
+    const/4 v1, 0x2
+
+    invoke-static {v0, v1}, Landroid/os/SystemProperties;->getInt(Ljava/lang/String;I)I
+
+    move-result v0
+
+    return v0
+.end method
+
+.method private static blacklist readMinHz()I
+    .locals 2
+
+    const-string v0, "ro.maxregner.flux.min_hz"
+
+    const/16 v1, 0xa
+
+    invoke-static {v0, v1}, Landroid/os/SystemProperties;->getInt(Ljava/lang/String;I)I
+
+    move-result v0
+
+    return v0
+.end method
+
+.method private static blacklist readMaxHz()I
+    .locals 2
+
+    const-string v0, "ro.maxregner.flux.max_hz"
+
+    const/16 v1, 0x78
+
+    invoke-static {v0, v1}, Landroid/os/SystemProperties;->getInt(Ljava/lang/String;I)I
+
+    move-result v0
+
+    return v0
+.end method
+
+.method private static blacklist readIdleHz()I
+    .locals 2
+
+    const-string v0, "ro.maxregner.flux.idle_hz"
+
+    const/16 v1, 0x18
+
+    invoke-static {v0, v1}, Landroid/os/SystemProperties;->getInt(Ljava/lang/String;I)I
+
+    move-result v0
+
+    return v0
+.end method
+
+.method public static blacklist isEnabled()Z
+    .locals 1
+
+    sget-boolean v0, Lio/mesalabs/unica/MaxregnerFlux;->sEnabled:Z
+
+    return v0
+.end method
+
+.method public static blacklist getMode()I
+    .locals 1
+
+    sget v0, Lio/mesalabs/unica/MaxregnerFlux;->sMode:I
+
+    return v0
+.end method
+
+.method public static blacklist getCurrentHz()I
+    .locals 1
+
+    sget v0, Lio/mesalabs/unica/MaxregnerFlux;->sCurrentHz:I
+
+    return v0
+.end method
+
+
+# virtual methods
+.method public blacklist onFrame(J)I
+    .locals 6
+
+    sget-boolean v0, Lio/mesalabs/unica/MaxregnerFlux;->sEnabled:Z
+
+    if-nez v0, :cond_enabled
+
+    sget v0, Lio/mesalabs/unica/MaxregnerFlux;->sMaxHz:I
+
+    return v0
+
+    :cond_enabled
+    sget v0, Lio/mesalabs/unica/MaxregnerFlux;->sMode:I
+
+    const/4 v1, 0x2
+
+    if-eq v0, v1, :cond_content
+
+    const/4 v1, 0x3
+
+    if-eq v0, v1, :cond_content
+
+    sget v0, Lio/mesalabs/unica/MaxregnerFlux;->sMaxHz:I
+
+    sput v0, Lio/mesalabs/unica/MaxregnerFlux;->sCurrentHz:I
+
+    return v0
+
+    :cond_content
+    sget-wide v0, Lio/mesalabs/unica/MaxregnerFlux;->sLastFrameMs:J
+
+    const-wide/16 v2, 0x0
+
+    cmp-long v4, v0, v2
+
+    if-nez v4, :cond_compute
+
+    sput-wide p1, Lio/mesalabs/unica/MaxregnerFlux;->sLastFrameMs:J
+
+    sget v0, Lio/mesalabs/unica/MaxregnerFlux;->sMaxHz:I
+
+    sput v0, Lio/mesalabs/unica/MaxregnerFlux;->sCurrentHz:I
+
+    return v0
+
+    :cond_compute
+    sub-long v0, p1, v0
+
+    const-wide/16 v2, 0x3e8
+
+    mul-long/2addr v0, v2
+
+    sget v2, Lio/mesalabs/unica/MaxregnerFlux;->sMaxHz:I
+
+    int-to-long v2, v2
+
+    div-long/2addr v0, v2
+
+    long-to-int v0, v0
+
+    sput-wide p1, Lio/mesalabs/unica/MaxregnerFlux;->sLastFrameMs:J
+
+    sget v1, Lio/mesalabs/unica/MaxregnerFlux;->sMinHz:I
+
+    if-ge v0, v1, :cond_clamp_high
+
+    sget v0, Lio/mesalabs/unica/MaxregnerFlux;->sIdleHz:I
+
+    sput v0, Lio/mesalabs/unica/MaxregnerFlux;->sCurrentHz:I
+
+    return v0
+
+    :cond_clamp_high
+    sget v1, Lio/mesalabs/unica/MaxregnerFlux;->sMaxHz:I
+
+    if-le v0, v1, :cond_set
+
+    sget v0, Lio/mesalabs/unica/MaxregnerFlux;->sMaxHz:I
+
+    :cond_set
+    sput v0, Lio/mesalabs/unica/MaxregnerFlux;->sCurrentHz:I
+
+    return v0
+.end method
