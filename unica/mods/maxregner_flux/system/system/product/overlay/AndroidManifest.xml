<?xml version="1.0" encoding="utf-8"?>
<!-- Maxregner Flux runtime overlay. Targets android (framework-res) at high
     priority to override the refresh-rate config the SurfaceFlinger
     arbitrator reads when the Flux engine is active. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.maxregner.flux.overlay"
    android:versionCode="39"
    android:versionName="39.0">
    <overlay android:targetPackage="android" android:priority="9999" android:category="theme" />
    <application android:label="Maxregner Flux" android:hasCode="false" android:allowBackup="false" />
</manifest>
