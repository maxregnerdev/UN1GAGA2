<?xml version="1.0" encoding="utf-8"?>
<!-- Maxregner Orb v2 system configuration.
     Marks the Maxregner Orb as a privileged system navigation component so it
     is allowed to inject navigation actions (Home/Back/Recents/Split-screen),
     render on top of other applications, and bind the v2 gesture/radial-menu
     surface. -->
<config>
    <!-- The Maxregner Orb v2 navigation service is trusted for system nav actions -->
    <allow-association target="com.maxregner.nav" allowed="android" />

    <!-- The orb overlay window may draw over apps to provide navigation -->
    <app-link package="com.maxregner.nav">
        <intent action="com.maxregner.nav.action.ORB" />
        <intent action="com.maxregner.nav.action.RADIAL_MENU" />
        <intent action="com.maxregner.nav.action.SPLIT_SCREEN" />
    </app-link>

    <!-- Permit the orb to remain alive across system restarts -->
    <keep-awake-services>
        <service name="com.maxregner.nav/.OrbService" />
        <service name="com.maxregner.nav/.RadialMenuService" />
    </keep-awake-services>

    <!-- v2: allow the orb to read the dock zone configuration -->
    <feature name="com.maxregner.nav.feature.MAGNETIC_DOCKING" />
    <feature name="com.maxregner.nav.feature.CONTEXTUAL_MORPH" />
    <feature name="com.maxregner.nav.feature.SPLIT_GESTURES" />
</config>
