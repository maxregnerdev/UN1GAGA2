<?xml version="1.0" encoding="utf-8"?>
<!-- Maxregner Orb v2 navigation runtime overlay.
     Advertises the v2 orb surface to the framework, suppresses the legacy
     3-button / gesture bar defaults, and enables the gesture input backend
     the orb sits on top of. -->
<overlay>
    <!-- Maxregner navigation mode v2 -->
    <item target="ro.maxregner.nav.enabled">true</item>
    <item target="ro.maxregner.nav.mode">orb</item>
    <item target="ro.maxregner.nav.version">2</item>

    <!-- Hide the legacy navigation bar; the Orb is rendered as an overlay -->
    <item target="config_showNavigationBar">false</item>

    <!-- Prefer gesture input as the input backend the Orb sits on top of -->
    <item target="config_supportsGesturalNavigation">true</item>

    <!-- Maxregner v2 features -->
    <item target="ro.maxregner.nav.radial_menu">true</item>
    <item target="ro.maxregner.nav.magnetic_snap">true</item>
    <item target="ro.maxregner.nav.split_gestures">true</item>
    <item target="ro.maxregner.nav.idle_breath">true</item>
</overlay>
