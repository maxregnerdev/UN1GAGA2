<?xml version="1.0" encoding="utf-8"?>
<!-- Maxregner Orb v3 runtime overlay. Targets android (framework-res) at high
     priority to override the navigation orb dimension defaults that SystemUI
     reads when the v3 orb controller is active. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.maxregner.orb3.overlay"
    android:versionCode="39"
    android:versionName="39.0">
    <overlay android:targetPackage="android" android:priority="9999" android:category="theme" />
    <application android:label="Maxregner Orb v3" android:hasCode="false" android:allowBackup="false" />
</manifest>
