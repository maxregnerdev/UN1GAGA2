<?xml version="1.0" encoding="utf-8"?>
<!-- Maxregner Living Surface runtime overlay. Targets android (framework-res)
     at high priority to override the depth/parallax dimension defaults the
     window animator and launcher read when the spatial layer is on. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.maxregner.spatial.overlay"
    android:versionCode="39"
    android:versionName="39.0">
    <overlay android:targetPackage="android" android:priority="9999" android:category="theme" />
    <application android:label="Maxregner Living Surface" android:hasCode="false" android:allowBackup="false" />
</manifest>
