        "brand_dark": "#2563EB",
        "accent":     "#8B5CF6",
        "surface":    "#FFFFFF",
        "surface_dark": "#0F172A",
        "on_surface": "#0B1220",
        "on_surface_dark": "#E5E7EB",
        "orb":        "#6366F1",
