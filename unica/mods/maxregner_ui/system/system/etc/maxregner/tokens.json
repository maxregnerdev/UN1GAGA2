            "core":   "#818CF8",
            "ring":   "#6366F1",
            "glow":   "#A5B4FC",
            "rim":    "#C7D2FE",
            "spark":  "#FFFFFF"
        }
    },
    "shape": {
        "scale": "maxregner_v2",
        "corner_none": 0,
        "corner_xs": 4,
        "corner_s": 8,
        "corner_m": 12,
        "corner_l": 16,
        "corner_xl": 24,
        "corner_xxl": 32,
        "corner_full": 9999,
        "corner_orb": 9999
    },
    "elevation": {
        "none": 0,
        "level1": 1,
        "level2": 3,
        "level3": 6,
        "level4": 8,
        "level5": 12
    },
    "motion": {
        "duration_instant": 50,
        "duration_short":   150,
        "duration_medium":  280,
        "duration_long":    450,
        "duration_xlong":   600,
        "easing_standard":   [0.20, 0.00, 0.00, 1.00],
        "easing_emphasized":  [0.20, 0.00, 0.00, 1.00],
        "easing_emphasized_accelerate": [0.30, 0.00, 1.00, 1.00],
        "easing_emphasized_decelerate": [0.05, 0.70, 0.10, 1.00],
        "easing_overshoot": [0.34, 1.56, 0.64, 1.00]
    },
    "type": {
        "ramp": ["display", "headline", "title", "body", "label", "caption"],
        "font_family": "maxregner_sans",
        "tracking": {
            "display": "-0.02em",
            "headline": "-0.01em",
            "title": "0.0em",
            "body": "0.01em",
            "label": "0.04em",
            "caption": "0.08em"
        }
    },
    "blur": {
        "none": 0,
        "subtle": 8,
        "standard": 16,
        "strong": 24,
        "glass": 32
    }
