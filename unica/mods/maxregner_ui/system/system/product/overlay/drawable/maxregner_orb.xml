<?xml version="1.0" encoding="utf-8"?>
<!-- Maxregner glass orb: layered glassmorphic navigation surface.
     Outer glow → ring stroke → core fill → inner rim highlight → top-left spark.
     All radii anchored at the orb centre (30,30) on a 60x60 viewport. -->
<vector android:height="60.0dp" android:width="60.0dp" android:viewportWidth="60.0" android:viewportHeight="60.0"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Soft outer glow -->
    <path android:fillColor="@color/maxregner_orb_glow" android:fillAlpha="0.30"
        android:pathData="M30,2 m-28,0 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0" android:fillType="evenOdd" />

    <!-- 2. Ring stroke (indigo) -->
    <path android:fillColor="@color/maxregner_orb_ring" android:fillAlpha="0.22"
        android:pathData="M30,6 m-24,0 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0" android:fillType="evenOdd" />

    <!-- 3. Core fill (vivid indigo) -->
    <path android:fillColor="@color/maxregner_orb_core"
        android:pathData="M30,12 m-18,0 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0" android:fillType="evenOdd" />

    <!-- 4. Inner rim highlight (rim color, offset down-right to fake a top light) -->
    <path android:fillColor="@color/maxregner_orb_rim" android:fillAlpha="0.55"
        android:pathData="M30,16 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0" android:fillType="evenOdd" />

    <!-- 5. Top-left specular spark -->
    <path android:fillColor="@color/maxregner_orb_spark" android:fillAlpha="0.75"
        android:pathData="M23,18 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" android:fillType="evenOdd" />
</vector>
