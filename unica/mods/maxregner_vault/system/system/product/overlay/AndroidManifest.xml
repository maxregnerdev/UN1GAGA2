<?xml version="1.0" encoding="utf-8"?>
<!-- Maxregner Vault runtime overlay. Targets android (framework-res) at high
     priority to override the permission/privacy config the permission
     controller reads when the Vault engine is active. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.maxregner.vault.overlay"
    android:versionCode="39"
    android:versionName="39.0">
    <overlay android:targetPackage="android" android:priority="9999" android:category="theme" />
    <application android:label="Maxregner Vault" android:hasCode="false" android:allowBackup="false" />
</manifest>
